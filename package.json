{
  "name": "admin-panel-everywhere",
  "version": "1.0.1",
  "description": "Static universal admin client with Telegraph Cloud document integration",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "npm run preview",
    "dev": "npm run build && npm run preview",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "pages:preview": "node scripts/pages-preview.mjs",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flessan/admin-panel-everywhere.git"
  },
  "keywords": [
    "admin-dashboard",
    "telegraph-cloud",
    "cloudflare-pages"
  ],
  "author": "Ahmad Raza",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/flessan/admin-panel-everywhere/issues"
  },
  "homepage": "https://github.com/flessan/admin-panel-everywhere#readme",
  "devDependencies": {
    "jsdom": "^26.1.0",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=22"
  }
}
